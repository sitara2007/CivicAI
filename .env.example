nano SECURITY.mdENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000

DATABASE_URL=postgresql+asyncpg://govai:devpassword@127.0.0.1:5432/civicai
DATABASE_ENABLED=true
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

OPENAI_API_KEY=replace-me
OPENAI_MODEL=llama-3.3-70b-versatile
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MOCK_LLM=true

RAG_ENABLED=false
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_QDRANT_PATH=data/qdrant_db
RAG_COLLECTION_NAME=gov_docs
RAG_TOP_K=3
RAG_CONTEXT_MAX_CHARS=4000

SYNC_MODE=true
MAX_AGENTIC_HOPS=5
REVIEW_CONFIDENCE_THRESHOLD=0.75

# Server-side Next.js proxy to the mTLS-protected Go redaction endpoint.
NEXT_PUBLIC_API_BASE=https://civicai-backend-hb5e.onrender.com
GO_INGEST_URL=https://localhost:8443/v1/redact
GO_INGEST_CLIENT_CERT=
GO_INGEST_CLIENT_KEY=
GO_INGEST_SERVER_CA=
