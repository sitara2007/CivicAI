ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000

DATABASE_URL=postgresql+asyncpg://govflow:devpassword@postgres:5432/civicos.db
DATABASE_ENABLED=true
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MOCK_LLM=true

RAG_ENABLED=true
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_QDRANT_PATH=data/qdrant_db
RAG_COLLECTION_NAME=gov_docs
RAG_TOP_K=3
RAG_CONTEXT_MAX_CHARS=4000

SYNC_MODE=true
MAX_AGENTIC_HOPS=5
REVIEW_CONFIDENCE_THRESHOLD=0.75

# Server-side Next.js proxy to the mTLS-protected Go redaction endpoint.
NEXT_PUBLIC_API_BASE=https://civicos-480a.onrender.com
GO_INGEST_URL=https://localhost:8443/v1/redact
GO_INGEST_CLIENT_CERT=
GO_INGEST_CLIENT_KEY=
GO_INGEST_SERVER_CA=
